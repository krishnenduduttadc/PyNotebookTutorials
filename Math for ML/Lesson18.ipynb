   "source": [
    "import numpy as np\n",
    "\n",
    "Q = np.array([[1,2]])\n",
    "\n",
    "K = np.array([[2,3]])\n",
    "\n",
    "V = np.array([[10,20]])\n",
    "\n",
    "scores = Q @ K.T\n",
    "\n",
    "weights = np.exp(scores) / np.sum(np.exp(scores))\n",
    "\n",
    "output = weights @ V\n",
    "\n",
    "print(output)"
   ]
  }
 ],
