   ],
   "source": [
    "from sklearn.mixture import GaussianMixture\n",
    "import numpy as np\n",
    "\n",
    "X = np.array([\n",
    "    [50],[55],[60],\n",
    "    [85],[90],[95]\n",
    "])\n",
    "\n",
    "gmm = GaussianMixture(\n",
    "    n_components=2,\n",
    "    random_state=0\n",
    ")\n",
    "\n",
    "gmm.fit(X)\n",
    "\n",
    "print(\"Means:\")\n",
    "print(gmm.means_)"
   ]
  },
