   "source": [
    "import numpy as np\n",
    "\n",
    "query = np.array([1,2])\n",
    "\n",
    "doc1 = np.array([2,4])\n",
    "doc2 = np.array([5,1])\n",
    "\n",
    "def cosine(a,b):\n",
    "    return np.dot(a,b) / (\n",
    "        np.linalg.norm(a)\n",
    "        * np.linalg.norm(b)\n",
    "    )\n",
    "\n",
    "print(cosine(query,doc1))\n",
    "print(cosine(query,doc2))"
   ]
  },
