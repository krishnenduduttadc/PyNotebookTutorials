   "source": [
    "import networkx as nx\n",
    "import numpy as np\n",
    "\n",
    "G = nx.Graph()\n",
    "\n",
    "G.add_edges_from([\n",
    "    (0,1),\n",
    "    (1,2),\n",
    "    (2,3),\n",
    "    (3,0)\n",
    "])\n",
    "\n",
    "L = nx.laplacian_matrix(G).toarray()\n",
    "\n",
    "eigenvalues, eigenvectors = np.linalg.eig(L)\n",
    "\n",
    "print(eigenvalues)"
   ]
  },
