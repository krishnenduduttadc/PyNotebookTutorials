   "source": [
    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "    return x**2\n",
    "\n",
    "x = np.linspace(-5,5,100)\n",
    "\n",
    "best_x = x[np.argmin(f(x))]\n",
    "\n",
    "print(best_x)"
   ]
  },
