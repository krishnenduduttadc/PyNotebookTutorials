   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "Q = np.zeros((5,2))\n",
    "\n",
    "alpha = 0.1\n",
    "gamma = 0.9\n",
    "\n",
    "state = 0\n",
    "action = 1\n",
    "reward = 10\n",
    "next_state = 1\n",
    "\n",
    "Q[state,action] += alpha * (\n",
    "    reward +\n",
    "    gamma*np.max(Q[next_state])\n",
    "    -\n",
    "    Q[state,action]\n",
    ")"
   ]
  },
