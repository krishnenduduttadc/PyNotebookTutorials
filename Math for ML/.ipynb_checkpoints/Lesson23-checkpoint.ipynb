   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "encoder = nn.Linear(784,32)\n",
    "\n",
    "decoder = nn.Linear(32,784)\n",
    "\n",
    "x = torch.randn(1,784)\n",
    "\n",
    "z = encoder(x)\n",
    "\n",
    "x_hat = decoder(z)\n",
    "\n",
    "loss = ((x - x_hat)**2).mean()\n",
    "\n",
    "print(loss)"
   ]
