   "source": [
    "import numpy as np\n",
    "\n",
    "logits = np.array([3,1,0])\n",
    "\n",
    "exp_vals = np.exp(logits)\n",
    "\n",
    "probs = exp_vals / exp_vals.sum()\n",
    "\n",
    "print(probs)"
