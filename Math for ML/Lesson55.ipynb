   "source": [
    "x = torch.tensor(\n",
    "    2.0,\n",
    "    requires_grad=True\n",
    ")\n",
    "\n",
    "y = torch.tensor(\n",
    "    3.0,\n",
    "    requires_grad=True\n",
    ")\n",
    "\n",
    "z = (x+y)**2\n",
    "\n",
    "z.backward()\n",
    "\n",
    "print(x.grad)\n",
    "print(y.grad)"
   ]
