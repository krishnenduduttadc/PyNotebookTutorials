    "import torch\n",
    "\n",
    "x = torch.tensor(\n",
    "    2.0,\n",
    "    requires_grad=True\n",
    ")\n",
    "\n",
    "y = x**2\n",
    "\n",
    "y.backward()\n",
    "\n",
    "print(x.grad)"
