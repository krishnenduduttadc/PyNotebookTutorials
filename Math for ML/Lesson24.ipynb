    "Q = 5\n",
    "\n",
    "alpha = 0.1\n",
    "\n",
    "reward = 10\n",
    "\n",
    "gamma = 0.9\n",
    "\n",
    "best_future = 8\n",
    "\n",
    "Q = Q + alpha * (\n",
    "    reward +\n",
    "    gamma * best_future -\n",
    "    Q\n",
    ")\n",
    "\n",
    "print(Q)"
