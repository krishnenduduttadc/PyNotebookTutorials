   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "N = 10000\n",
    "\n",
    "samples = []\n",
    "\n",
    "x = 0\n",
    "\n",
    "for _ in range(N):\n",
    "\n",
    "    proposal = x + np.random.normal()\n",
    "\n",
    "    r = np.exp(\n",
    "        -(proposal**2 - x**2)/2\n",
    "    )\n",
    "\n",
    "    if np.random.rand() < min(1,r):\n",
    "        x = proposal\n",
    "\n",
    "    samples.append(x)"
   ]
