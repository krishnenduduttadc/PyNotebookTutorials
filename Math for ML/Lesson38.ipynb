   "source": [
    "import numpy as np\n",
    "\n",
    "p = np.array([1,0,0])\n",
    "\n",
    "q = np.array([0.9,0.05,0.05])\n",
    "\n",
    "cross_entropy = -np.sum(\n",
    "    p * np.log(q)\n",
    ")\n",
    "\n",
    "print(cross_entropy)"
   ]
