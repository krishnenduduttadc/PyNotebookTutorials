    "import matplotlib.pyplot as plt\n",
    "\n",
    "traffic = [120, 340, 560]\n",
    "labels = [\"Flow1\", \"Flow2\", \"Flow3\"]\n",
    "\n",
    "plt.bar(labels, traffic)\n",
    "plt.xlabel(\"Network Flow\")\n",
    "plt.ylabel(\"Bytes Transferred\")\n",
    "plt.title(\"Simple Network Traffic Visualization\")\n",
    "plt.show()\n"
